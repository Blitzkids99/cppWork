{
  "files.exclude": {
    "**/build": true,
    "**/*.exe": true,
    "**/*.o": true,
    "**/*.out": true,
    "**/a.out": true,
    "**/.DS_Store": true
  },
  "search.exclude": {
    "**/build": true
  },

  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "code-runner.clearPreviousOutput": true,
  "code-runner.executorMap": {
    "cpp": "cd $dir && mkdir -p $workspaceRoot/build && g++ -std=c++11 -Wall -Wextra $fileName -o $workspaceRoot/build/$fileNameWithoutExt && $workspaceRoot/build/$fileNameWithoutExt"
  }
}
